{
  "name": "maeusebau",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pages": "vite build --mode pages",
    "preview:pages": "vite preview --mode pages --host 127.0.0.1 --port 4173 --strictPort",
    "phone": "vite build --mode phone && vite preview --mode phone --host 127.0.0.1 --port 4173 --strictPort",
    "phone:pwa": "vite build && vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.core.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "core:rebaseline": "node scripts/core-rebaseline.mjs",
    "core:bench": "node scripts/core-bench.mjs",
    "check-dist": "node scripts/check-dist.mjs",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test --grep-invert @local",
    "e2e:local": "playwright test --grep @local",
    "e2e:fakecam": "playwright test --project chromium-fakecam",
    "e2e:fakecam-foreign": "playwright test --project chromium-fakecam-foreign",
    "icons": "node scripts/make-icons.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build:pages && npm run check-dist && npm run e2e:smoke"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "@types/qrcode": "1.5.6",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.1",
    "workbox-window": "7.4.1"
  },
  "dependencies": {
    "@babylonjs/core": "9.27.1",
    "idb": "8.0.3",
    "qr-scanner": "1.4.2",
    "qrcode": "1.5.4"
  }
}
